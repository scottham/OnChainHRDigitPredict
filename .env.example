# One entry per network the app should offer -- the MNISTPacked address on that
# chain. Unset, each chain falls back to its deployments.*.json, so these are
# overrides, not required. Chains without a deployed address are omitted.
NEXT_PUBLIC_CONTRACT_ADDRESS_143=0x83e765e0b243929c561f9e797fbc0416bcf7044d
NEXT_PUBLIC_CONTRACT_ADDRESS_10143=0xbb66cc0e2b8de0c8f1542cfec1388fd79106efbf
# NEXT_PUBLIC_CONTRACT_ADDRESS_1=0x...        # Ethereum
# NEXT_PUBLIC_CONTRACT_ADDRESS_11155111=0x... # Sepolia
# NEXT_PUBLIC_CONTRACT_ADDRESS_10=0x...       # OP Mainnet
# NEXT_PUBLIC_CONTRACT_ADDRESS_11155420=0x... # OP Sepolia

# Which one is selected on first visit (the user can switch in the header).
NEXT_PUBLIC_DEFAULT_CHAIN_ID=143

# Optional per-network RPC overrides; each chain's public RPC is the default.
# NEXT_PUBLIC_RPC_URL_143=https://rpc.monad.xyz
# NEXT_PUBLIC_RPC_URL_10143=https://testnet-rpc.monad.xyz
# NEXT_PUBLIC_RPC_URL_1=https://...
# NEXT_PUBLIC_RPC_URL_11155111=https://...
# NEXT_PUBLIC_RPC_URL_10=https://mainnet.optimism.io
# NEXT_PUBLIC_RPC_URL_11155420=https://sepolia.optimism.io

# Token whose weights the demo runs by default
NEXT_PUBLIC_DEFAULT_TOKEN_ID=1

# Optional: from https://cloud.reown.com. Without it, injected wallets
# (MetaMask, Rabby) still work -- only WalletConnect/mobile flows are disabled.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deploy scripts only; never referenced by the frontend.
PRIVATE_KEY=
# Optional deployment RPC overrides. Browser RPC overrides above are separate.
# ETHEREUM_RPC_URL=https://...
# SEPOLIA_RPC_URL=https://...
# OP_RPC_URL=https://mainnet.optimism.io
# OP_SEPOLIA_RPC_URL=https://sepolia.optimism.io
